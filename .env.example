PORT=3001
# Azure supplies PORT. Startup binds to 0.0.0.0.
# Set NODE_ENV=production in App Settings; local development can leave it unset.
# Set TRUST_PROXY=1 only behind Azure App Service's front proxy.
TRUST_PROXY=

# sqlite (default) or azure-sql; SQL failures never fall back to SQLite.
DATABASE_BACKEND=sqlite
# Relative paths resolve from the repository root. Absolute paths are also supported.
DATABASE_PATH=data/ai-capsule.sqlite

# Register at https://github.com/settings/applications/new
# Homepage URL: https://localhost:5173
# Authorization callback URL: https://localhost:5173/api/auth/github/callback
# Use the same public HTTPS origin for the app and callback in production.
PUBLIC_APP_URL=https://localhost:5173
GITHUB_CALLBACK_URL=https://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate locally: openssl rand -hex 32 (never commit the result).
JWT_SECRET=

# Local setup under Node 24.19+: run npm run dev:cert once, then npm run dev
# and npm --prefix client run dev. Trust .certs/localhost.pem locally or accept
# its browser warning at https://localhost:5173. Certificates expire after 30 days.
# PORT is the internal HTTP backend; open the HTTPS Vite URL in the browser.
# Only VITE_-prefixed variables are exposed to frontend JavaScript. Never prefix secrets.

# Required only for DATABASE_BACKEND=azure-sql. No passwords or connection strings.
AZURE_SQL_SERVER=sql-ai-capsule-23025563.database.windows.net
AZURE_SQL_DATABASE=ai-capsule
# managed-identity: App Service system identity (runtime).
# default: Azure credential chain, including az login, for an authorised migration user.
AZURE_SQL_AUTHENTICATION=managed-identity
# Run npm run db:migrate separately with the migration identity before app startup.
# Runtime needs SELECT, INSERT, UPDATE, DELETE on dbo.capsules only; no DDL.
